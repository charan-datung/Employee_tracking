<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app live camera preview via getUserMedia (CLAUDE.md rule 6).
         The WebView requires this app-level permission before
         onPermissionRequest can grant camera access to the page.
         @capacitor/camera is banned in this codebase. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Location tracking (services/location). Declared explicitly for
         auditability even though the background-geolocation plugin's manifest
         also merges them — duplicates are collapsed by the manifest merger.

         ACCESS_COARSE_LOCATION is an OS requirement on Android 12+ when
         requesting FINE (the permission dialog needs both declared). It does
         NOT mean coarse fixes are accepted: capture-time code rejects
         simulated and >100m-accuracy readings (CLAUDE.md rule 5). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The interval-tracking watcher runs as a foreground service while an
         attendance session is open. FOREGROUND_SERVICE_LOCATION is REQUIRED
         from Android 14 (API 34) for any service with
         foregroundServiceType="location"; the <service> declaration itself
         (com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService,
         android:foregroundServiceType="location") is merged from the
         plugin's own manifest — do not redeclare it here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- ACCESS_BACKGROUND_LOCATION is deliberately ABSENT. The foreground-
         service pattern does not need it: while the service (and its visible
         notification) is running, while-in-use location keeps flowing with
         the screen off. Background permission would only be needed to sample
         location WITHOUT a foreground service — which this app must never do
         (CLAUDE.md rule 4, RA 10173 proportionality). Requesting it would
         also trigger Google Play's prominent-disclosure / background-location
         review for zero benefit. Do not add it. -->

    <!-- Merged automatically from other plugin manifests (do not redeclare):
         background-geolocation additionally: POST_NOTIFICATIONS
         @capacitor/network: ACCESS_NETWORK_STATE
         @capacitor/local-notifications:
           RECEIVE_BOOT_COMPLETED, WAKE_LOCK, POST_NOTIFICATIONS -->

    <!-- GPS integrity is mandatory (CLAUDE.md rule 5): never fall back to
         coarse/network location, so devices without GPS hardware must not
         install this app at all — required="true" makes Play filter them. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />
</manifest>
