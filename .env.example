# Copy to .env (root) and fill in. Never commit real values.
# Per-app env files: apps/mobile/.env.local, apps/console/.env.local

# ---- Supabase project ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is SERVER-ONLY (edge functions, scripts). Never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- apps/mobile (Vite: only VITE_* vars are exposed to the client) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- apps/console (Next.js: only NEXT_PUBLIC_* vars are exposed to the client) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
