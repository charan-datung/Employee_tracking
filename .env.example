# Copy to .env (root) and fill in. Never commit real values.
# Per-app env files: apps/mobile/.env.local, apps/console/.env.local

# ---- Supabase project ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is SERVER-ONLY (edge functions, scripts). Never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- apps/mobile (Vite: only VITE_* vars are exposed to the client) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- apps/console (Next.js: only NEXT_PUBLIC_* vars are exposed to the client) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- apps/console ----
# Basemap tiles. The default is the PUBLIC OpenStreetMap server, which is fine
# for development and NOT PERMITTED for production traffic (OSMF tile policy).
# Point this at MapTiler / Stadia / a self-hosted Protomaps extract before go-live.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Self-hosted Nominatim for CSV import geocoding. Leave UNSET to disable
# geocoding entirely — imports still succeed and land as 'unverified' for the
# pin-review queue. The PUBLIC Nominatim instance must not be used for bulk.
NOMINATIM_URL=
NOMINATIM_USER_AGENT=DatungFieldConsole/1.0 (self-hosted)

# DURATION/HOURS COLUMNS IN REPORTS. Default false, deliberately.
# Enabling this has Philippine labor-law consequences under Article 82 —
# see apps/console/lib/reportFlags.ts. Ask the owner AND counsel first.
NEXT_PUBLIC_SHOW_DURATION=false

# ---- push notifications (edge function dispatch_notifications) ----
# Firebase project + service account JSON for FCM HTTP v1. Leave unset and the
# push channel stays dark: notification_log rows are still written and the
# console still shows everything, so nothing is lost.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
